 FontStyle bold
 AttributeFontColor #111111
}
skinparam package {
 BackgroundColor #FFFFFF
 BorderColor #555555
}
skinparam component {
 BackgroundColor #FFFDEB
 BorderColor #333333
}
skinparam node {
 BackgroundColor #F7F7F7
 BorderColor #333333
}
skinparam artifact {
 BackgroundColor #FFFDEB
 BorderColor #333333
}
skinparam sequence {
 ParticipantBackgroundColor #FFFDEB
 ParticipantBorderColor #333333
 LifeLineBorderColor #888888
 LifeLineBackgroundColor #FFFFFF
 GroupBackgroundColor #FFFFFF
 GroupBorderColor #777777
}
skinparam usecase {
 BackgroundColor #FFFFFF
 BorderColor #333333
}
skinparam state {
 BackgroundColor #FFFDEB
 BorderColor #333333
}
hide circle
hide empty members

left to right direction
class UMLDiagram
class UMLValidator {
+validate(): ValidationResult
}
class SpringBootGenerator {
+generate(): dict
}
class FlutterGenerator {
+generate_all(): dict
}
class XMIAdapter
class MDJAdapter
UMLValidator --> UMLDiagram : analiza
SpringBootGenerator --> UMLDiagram : transforma
FlutterGenerator --> UMLDiagram : transforma
XMIAdapter ..> UMLDiagram : importa y exporta
MDJAdapter ..> UMLDiagram : importa y exporta
