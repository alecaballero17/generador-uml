@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam dpi 220
skinparam roundcorner 0

skinparam nodesep 45
skinparam ranksep 50
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam classAttributeIconSize 0
skinparam class {
 BackgroundColor #FFFDEB
 BorderColor #333333
 FontColor #111111
 FontStyle bold
 AttributeFontColor #111111
}
skinparam package {
 BackgroundColor #FFFFFF
 BorderColor #555555
}
skinparam component {
 BackgroundColor #FFFDEB
 BorderColor #333333
}
skinparam node {
 BackgroundColor #F7F7F7
 BorderColor #333333
}
skinparam artifact {
 BackgroundColor #FFFDEB
 BorderColor #333333
}
skinparam sequence {
 ParticipantBackgroundColor #FFFDEB
 ParticipantBorderColor #333333
 LifeLineBorderColor #888888
 LifeLineBackgroundColor #FFFFFF
 GroupBackgroundColor #FFFFFF
 GroupBorderColor #777777
}
skinparam usecase {
 BackgroundColor #FFFFFF
 BorderColor #333333
}
skinparam state {
 BackgroundColor #FFFDEB
 BorderColor #333333
}
hide circle
hide empty members

left to right direction
actor Modelador as M
actor Administrador as A
actor Editor as E
actor Visualizador as V
actor "Gemini\nservicio externo" as G
A --|> M
E --|> M
rectangle GeneradorUML {
usecase "CU01 Gestionar elementos" as U1
usecase "CU02 Definir relaciones" as U2
usecase "CU03 Compartir acceso" as U3
usecase "CU04 Editar offline\ny sincronizar" as U4
usecase "CU05 Modelar por voz" as U5
usecase "CU06 Importar foto\ny revisar" as U6
usecase "CU07 Intercambiar modelos" as U7
usecase "CU08 Generar proyectos" as U8
usecase "CU09 Restaurar revisión" as U9
usecase "Consultar diagrama" as Q
}
M -- U1
M -- U2
M -- U5
M -- U6
M -- U7
M -- U8
M -- Q
A -- U3
A -- U9
E -- U4
A -- U4
V -- Q
G -- U5
@enduml
