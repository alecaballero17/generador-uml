@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam dpi 220
skinparam roundcorner 0

skinparam nodesep 45
skinparam ranksep 50
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam classAttributeIconSize 0
skinparam class {
 BackgroundColor #FFFDEB
 BorderColor #333333
 FontColor #111111
 FontStyle bold
 AttributeFontColor #111111
}
skinparam package {
 BackgroundColor #FFFFFF
 BorderColor #555555
}
skinparam component {
 BackgroundColor #FFFDEB
 BorderColor #333333
}
skinparam node {
 BackgroundColor #F7F7F7
 BorderColor #333333
}
skinparam artifact {
 BackgroundColor #FFFDEB
 BorderColor #333333
}
skinparam sequence {
 ParticipantBackgroundColor #FFFDEB
 ParticipantBorderColor #333333
 LifeLineBorderColor #888888
 LifeLineBackgroundColor #FFFFFF
 GroupBackgroundColor #FFFFFF
 GroupBorderColor #777777
}
skinparam usecase {
 BackgroundColor #FFFFFF
 BorderColor #333333
}
skinparam state {
 BackgroundColor #FFFDEB
 BorderColor #333333
}
hide circle
hide empty members

actor Modelador as U
participant "Interfaz" as UI
participant "Lector local" as L
participant "Tesseract" as OCR
participant "Modelo UML" as M
U -> UI : Seleccionar imagen
UI -> L : recognizeLocalPhoto(imagen)
L -> L : Estimar inclinación y separar cajas
L -> OCR : Reconocer compartimentos
OCR --> L : Texto
L --> UI : Texto y conexiones candidatas
U -> UI : Revisar y corregir texto
U -> UI : Confirmar importación
UI -> UI : Validar lote completo
alt Datos válidos
UI -> M : Incorporar clases y operaciones
UI --> U : Mostrar resultado y opción deshacer
else Duplicados o datos inválidos
UI --> U : Mostrar error y conservar modelo
end
@enduml
