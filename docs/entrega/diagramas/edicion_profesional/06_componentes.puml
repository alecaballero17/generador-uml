@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam dpi 220
skinparam roundcorner 0

skinparam nodesep 45
skinparam ranksep 50
skinparam ArrowColor #333333
skinparam ArrowThickness 1
skinparam classAttributeIconSize 0
skinparam class {
 BackgroundColor #FFFDEB
 BorderColor #333333
 FontColor #111111
 FontStyle bold
 AttributeFontColor #111111
}
skinparam package {
 BackgroundColor #FFFFFF
 BorderColor #555555
}
skinparam component {
 BackgroundColor #FFFDEB
 BorderColor #333333
}
skinparam node {
 BackgroundColor #F7F7F7
 BorderColor #333333
}
skinparam artifact {
 BackgroundColor #FFFDEB
 BorderColor #333333
}
skinparam sequence {
 ParticipantBackgroundColor #FFFDEB
 ParticipantBorderColor #333333
 LifeLineBorderColor #888888
 LifeLineBackgroundColor #FFFFFF
 GroupBackgroundColor #FFFFFF
 GroupBorderColor #777777
}
skinparam usecase {
 BackgroundColor #FFFFFF
 BorderColor #333333
}
skinparam state {
 BackgroundColor #FFFDEB
 BorderColor #333333
}
hide circle
hide empty members

top to bottom direction
skinparam linetype polyline
component "Editor JavaScript\ny lienzo SVG" as UI
component "Lector local\nOCR y transcripción" as AI
component "Colaboración cliente" as CC
component "API FastAPI" as API
component "Servicio colaborativo" as SC
component "Validación y\nmodelo UML" as M
component "Generadores y\nadaptadores" as GEN
component "Gemini externo" as G
UI ..> AI : invoca
UI ..> CC : cambios
UI ..> API : HTTP
CC ..> SC : WebSocket
API ..> M : valida
API ..> GEN : delega
GEN ..> M : utiliza
API ..> G : consulta opcional
SC ..> M : valida estructura
@enduml
